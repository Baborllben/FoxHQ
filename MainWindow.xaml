<Window x:Class="FoxHQ_installer_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FoxHQ_installer_WPF"
        mc:Ignorable="d"
        
        Title="FoxHQ Installer" Height="500" Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        MouseDown="MoveWindow"
        
        Loaded="Window_Loaded"
        AllowsTransparency="True"
        Opacity="0"
        >
    <Grid x:Name="Grid">
        <!-- 取消按钮，点击关闭窗口 -->
        <Button x:Name="CancelButton"
                Content="Cannel"
                Width="100" Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Background="White"
                
                
                FontSize="16"
                FontWeight="Light"
                
                BorderThickness="0"
                
                MouseLeave="CancelButton_MouseLeave"
                Click="Cancel_Click"
                />
        
        <!-- 加载页面（Logo页面） -->
        <Image  x:Name="LOGO"
                Source="Resources/logo.png"
                Width="80"
                Height="80"
                
                Panel.ZIndex="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
            
                Opacity="0"
            >
            <Image.RenderTransform>
                <TranslateTransform x:Name="LOGO_MoveTransform"/>
            </Image.RenderTransform>
        </Image>
            <!-- Fotailx LOGO下的文字 -->
        <TextBlock  x:Name="TEXT_Fotailx"
                    Text="Fotailx"
                    FontSize="30"
                    FontWeight="Light"
                 
                    Width="100" Height="36"
                    Margin="0,0,5,193"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom"
                 
                    Panel.ZIndex="0"
                    TextAlignment="Center"
                   
                    Opacity="0"
                 />
        <!-- 加载页面（Logo页面）END -->
    </Grid>
</Window>